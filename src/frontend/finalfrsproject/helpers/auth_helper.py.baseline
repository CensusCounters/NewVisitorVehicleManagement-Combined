import json
from flask import render_template, make_response, redirect, url_for, session, request
from finalfrsproject import app, sqlCommands
from flask_jwt_extended import create_access_token, set_access_cookies, unset_jwt_cookies, decode_token
from flask_babel import _
import time
from datetime import datetime
import uuid

ACTIVE_LOGIN_TTL_SECONDS = 300


def _active_login_key_prefix():
    return app.config.get("ACTIVE_LOGIN_KEY_PREFIX", "active_login:username:")


def _active_login_ttl_seconds():
    return int(app.config.get("ACTIVE_LOGIN_TTL_SECONDS", ACTIVE_LOGIN_TTL_SECONDS))


def _normalize_username(username):
    return str(username).strip()


def _active_login_key(username):
    return f"{_active_login_key_prefix()}{_normalize_username(username)}"


def _decode_redis_value(value):
    if value is None:
        return None
    if isinstance(value, bytes):
        return value.decode("utf-8")
    return str(value)

def login_get():
    start_time = time.time()
    start_timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    print(f"[{start_timestamp}] Starting auth_helper_login_get", flush=True)

    send_to_html_json = {
            'message': request.args.get('message') or _('Welcome. Please login with your name and password to continue.'),
            'page_title': _('Login'), 
            'lang': session.get('lang', 'en')
    }

    end_time = time.time()
    execution_time = round((end_time - start_time) * 1000, 2)  # Convert to milliseconds
    end_timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    print(f"[{end_timestamp}] Completed auth_helper_login_get | Execution time: {execution_time}ms", flush=True)

    return render_template('login.html', details=send_to_html_json)

def login_post(redis_conn, form):
    start_time = time.time()
    start_timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    print(f"[{start_timestamp}] Starting auth_helper_login_post", flush=True)

    active_login_key = None
    active_login_lock_id = None

    try:
        if form.get('username') and form.get('password'):
            #print("username: ", form.get('username'))
            #print("password: ", form.get('password'))
            result = sqlCommands.login(form.get('username'), form.get('password'))
            print("Login result: ", result, flush=True)
            if not result or result.get('Status') == "Fail" or not result.get('Details'):
                print("Login unsuccessful")
                send_to_html_json = {
                    'message': _('Login information incorrect. Please check the username and password entered.'),
                    'page_title': _('Login')
                }

                end_time = time.time()
                execution_time = round((end_time - start_time) * 1000, 2)  # Convert to milliseconds
                end_timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
                print(f"[{end_timestamp}] Completed auth_helper_login_post | Execution time: {execution_time}ms",flush=True)

                return render_template('login.html', details=send_to_html_json)
            else:
                result = result.get("Details")
                print("Login successful: ", result)

            logged_in_user_name = result[0]
            logged_in_user_type = result[1]
            logged_in_user_id = result[2]

            identity = {
                "logged_in_user_name": logged_in_user_name, 
                "logged_in_user_type": logged_in_user_type, 
                "logged_in_user_id": logged_in_user_id
            }
            if app.config.get("SINGLE_ACTIVE_LOGIN"):
                active_login_key = _active_login_key(logged_in_user_name)
                active_login_lock_id = str(uuid.uuid4())
                # New login replaces any existing lock so stale sessions can sign in again.
                redis_conn.set(
                    active_login_key,
                    active_login_lock_id,
                    ex=_active_login_ttl_seconds(),
                )
                identity.update({
                    "active_login_key": active_login_key,
                    "active_login_lock_id": active_login_lock_id,
                })
            access_token = create_access_token(identity=identity)
            #response = make_response(redirect(url_for('home')))
            #set_access_cookies(response, access_token)
            #return response


            #access the redis object if available
            destination = None

            if redis_conn.get(identity.get('logged_in_user_id')) is not None:
                session_values_json_redis = json.loads(redis_conn.get(identity.get('logged_in_user_id')))
                #redis_conn.delete(str(jwt_details.get('logged_in_user_id')))
                print("redis in login: ", session_values_json_redis, flush=True)
                if session_values_json_redis.get("ticket_status") is not None:
                    destination = session_values_json_redis.get("ticket_status")
                    print("redis in login destination: ",destination, flush=True)
                else:
                    print("redis in login: no ticket status", flush=True)
                    destination = "home"
                    print("redis in login destination: ",destination, flush=True)
            else:
                print("redis in login not available", flush=True)
                destination = "home"
                print("redis in login destination: ",destination, flush=True)
                
            response = make_response(redirect(url_for('home')))
            #response = make_response(redirect(url_for(destination)))
            set_access_cookies(response, access_token)
            end_time = time.time()
            execution_time = round((end_time - start_time) * 1000, 2)  # Convert to milliseconds
            end_timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            print(f"[{end_timestamp}] Completed auth_helper_login_post | Execution time: {execution_time}ms", flush=True)

            return response

        else:
            print("No username and password in login")
            send_to_html_json = {
                'message': _('Welcome. Please login with your name and password to continue.'),
                'page_title': _('Login')
            }

            end_time = time.time()
            execution_time = round((end_time - start_time) * 1000, 2)  # Convert to milliseconds
            end_timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            print(f"[{end_timestamp}] Completed auth_helper_login_post | Execution time: {execution_time}ms", flush=True)

            return render_template('login.html', details=send_to_html_json)

    except Exception as e:
        if active_login_key and active_login_lock_id:
            current_lock_id = _decode_redis_value(redis_conn.get(active_login_key))
            if current_lock_id == active_login_lock_id:
                redis_conn.delete(active_login_key)
        print(f"Error in login post: {str(e)}")
        send_to_html_json = {
            'message': _('An unexpected error occurred. Please try again.'),
            'page_title': _('Login')
        }

        end_time = time.time()
        execution_time = round((end_time - start_time) * 1000, 2)  # Convert to milliseconds
        end_timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
        print(f"[{end_timestamp}] Completed auth_helper_login_post | Execution time: {execution_time}ms", flush=True)

        return render_template('login.html', details=send_to_html_json)

def logout_post(jwt_details, redis_conn, form):
    if form.get('No'):
        return redirect(url_for('home'))
    return logout_get(jwt_details, redis_conn, form)


def logout_get(jwt_details, redis_conn, form):
    try:
        if jwt_details:
            if app.config.get("SINGLE_ACTIVE_LOGIN"):
                active_login_key = jwt_details.get('active_login_key')
                if not active_login_key and jwt_details.get('logged_in_user_name'):
                    active_login_key = _active_login_key(jwt_details['logged_in_user_name'])
                if active_login_key:
                    redis_conn.delete(active_login_key)
            user_id = str(jwt_details.get('logged_in_user_id'))
            if user_id:
                redis_conn.delete(user_id)  # Remove session from Redis
            if redis_conn.get(user_id) is not None:
                session_values_json_redis = json.loads(redis_conn.get(user_id))
                print('redis in logout when delete redis is selected: ', session_values_json_redis, flush=True)
            else:
                print('redis deleted in logout', flush=True)
        response = make_response(redirect(url_for('login')))
        unset_jwt_cookies(response)
        return response
    except Exception as e:
        print(f"Error in logout: {str(e)}")
        send_to_html_json = {
            'message': _('An unexpected error occurred at logout. Please try again.'),
            'page_title': _('Login')
        }
        return render_template('login.html', details=send_to_html_json)
