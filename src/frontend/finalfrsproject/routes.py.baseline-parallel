@app.route("/api/get_unfinished_trips_table", methods=["POST"])
@jwt_required()
def get_unfinished_trips_table():
    jwt_details = get_jwt_identity()

    session_values_json_redis = json.loads(redisCommands.redis_conn.get(jwt_details.get('logged_in_user_id')))
    open_trip_person_id = session_values_json_redis.get("open_trip_person_id")

    draw = int(request.form.get("draw", 1))
    start = int(request.form.get("start", 0))
    length = int(request.form.get("length", 50))
    search_value = request.form.get("search[value]", "").strip()
    order_col_idx = int(request.form.get("order[0][column]", 6))
    order_dir = request.form.get("order[0][dir]", "desc")

    column_filters = {}
    for i in range(16):
        val = request.form.get(f"columns[{i}][search][value]", "").strip()
        if val:
            column_filters[i] = val

    entry_time_preset = request.form.get("entry_time_preset", "").strip()
    exit_time_preset = request.form.get("exit_time_preset", "").strip()
    if entry_time_preset:
        column_filters[6] = entry_time_preset
    if exit_time_preset:
        column_filters[7] = exit_time_preset

    result = sqlCommands.get_unfinished_trips_paginated(
        person_id=open_trip_person_id,
        start=start,
        length=length,
        search_value=search_value,
        order_col_idx=order_col_idx,
        order_dir=order_dir,
        column_filters=column_filters,
    )

    if not result or result.get("Status") == "Fail":
        return jsonify({
            "draw": draw,
            "recordsTotal": 0,
            "recordsFiltered": 0,
            "data": [],
        }), 200

    return jsonify({
        "draw": draw,
        "recordsTotal": result.get("recordsTotal", 0),
        "recordsFiltered": result.get("recordsFiltered", 0),
        "data": result.get("Details", []),
    })


