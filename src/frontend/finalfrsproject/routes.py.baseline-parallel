# Cache shipped frontend assets, but never cache dynamic pages or runtime-generated files.
@app.after_request
def after_request(response):
    cacheable_asset_prefixes = (
        "/static/css/",
        "/static/js/",
        "/static/fonts/",
        "/static/models/",
    )
    cacheable_asset_files = (
        "/static/favicon-32x32.png",
        "/static/images/vajr-28-div-logo.jpeg",
        "/static/images/7RR-Logo.jpeg",
        "/static/images/amogh-ganganagar-logo.png",
        "/static/images/shakti-vijay-logo.jpeg",
        "/static/images/question.png",
        "/static/placeholder.png",
        "/static/images/census-logo.png",
    )

    if request.path.startswith(cacheable_asset_prefixes) or request.path in cacheable_asset_files:
        response.headers["Cache-Control"] = "public, max-age=2592000, immutable"
        response.headers.pop("Pragma", None)
        response.headers.pop("Expires", None)
    else:
        response.headers["Cache-Control"] = "no-cache, no-store, must-revalidate"
        response.headers["Pragma"] = "no-cache"
        response.headers["Expires"] = "0"

    return response


@app.before_request
def enforce_active_login_lock():
    """When enabled, only the most recent login for a username stays active."""

    if not app.config.get("SINGLE_ACTIVE_LOGIN"):
        return None

    try:
        verify_jwt_in_request(optional=True)
    except Exception:
        # JWT callbacks remain responsible for malformed or expired tokens.
        return None

    identity = get_jwt_identity()
    if not isinstance(identity, dict):
        return None

    active_login_key = identity.get("active_login_key")
    active_login_lock_id = identity.get("active_login_lock_id")
    if not active_login_key or not active_login_lock_id:
        return None

    current_lock_value = redisCommands.redis_conn.get(active_login_key)
    if isinstance(current_lock_value, bytes):
        current_lock_value = current_lock_value.decode("utf-8")

    if current_lock_value != active_login_lock_id:
        session.clear()
        message = _("Your session is no longer active. Please login again.")
        response = make_response(redirect(url_for('login', message=message)))
        unset_jwt_cookies(response)
        return response

    redisCommands.redis_conn.expire(
        active_login_key, auth_helper._active_login_ttl_seconds()
    )
    return None

