networks:
  census_counters_network:
    external: true

volumes:
  census_counters_facedb:
    driver: local
  census_counters_etcd:
    driver: local
  census_counters_minio:
    driver: local
  census_counters_postgres_data:
    driver: local
  census_counters_redis_data:
    driver: local

services:
  census_counters_postgres_db:
    image: postgres:15.1-alpine
    container_name: census_counters_postgres_db
    restart: always
    environment:
      POSTGRES_USER: ${DB_USER_NAME:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
      POSTGRES_DB: ${DB_NAME:-postgres_visitor_vehicle}
    volumes:
      - census_counters_postgres_data:/var/lib/postgresql/data
    networks:
      - census_counters_network
    profiles:
      - bundled_infra

  census_counters_redis:
    image: redis:7-alpine
    container_name: census_counters_redis
    restart: always
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - census_counters_redis_data:/data
    networks:
      - census_counters_network
    profiles:
      - bundled_infra

  census_counters_etcd:
    container_name: census_counters_etcd
    image: quay.io/coreos/etcd:v3.5.18
    restart: always
    environment:
      - ETCD_AUTO_COMPACTION_MODE=revision
      - ETCD_AUTO_COMPACTION_RETENTION=1000
      - ETCD_QUOTA_BACKEND_BYTES=4294967296
      - ETCD_SNAPSHOT_COUNT=50000
    networks:
      - census_counters_network
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - census_counters_etcd:/etcd
    command: etcd -advertise-client-urls=http://census_counters_etcd:2379 -listen-client-urls http://0.0.0.0:2379 --data-dir /etcd
    healthcheck:
      test: [ "CMD", "etcdctl", "endpoint", "health" ]
      interval: 30s
      timeout: 20s
      retries: 3
    profiles:
      - visitor_vehicle

  #this name was bugged: underscore name wasn't worked with milvus...
  censuscountersminio:
    container_name: censuscountersminio
    image: minio/minio:RELEASE.2023-03-20T20-16-18Z
    restart: always
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    ports:
      - "9001:9001"
      - "9000:9000"
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - census_counters_minio:/minio_data
    networks:
      - census_counters_network
    command: minio server /minio_data --console-address ":9001"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 20s
      retries: 3
    profiles:
      - visitor_vehicle

  census_counters_facedb:
    container_name: census_counters_facedb
    image: milvusdb/milvus:v2.5.13-gpu
    command: ["milvus", "run", "standalone"]
    restart: always
    security_opt:
      - seccomp:unconfined
    environment:
      ETCD_ENDPOINTS: census_counters_etcd:2379
      MINIO_ADDRESS: censuscountersminio:9000
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ['0']
              capabilities: [gpu]
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - census_counters_facedb:/var/lib/milvus
    networks:
      - census_counters_network
    ports:
      - "19530:19530"
      - "9091:9091"
    depends_on:
      - "census_counters_etcd"
      - "censuscountersminio"
    profiles:
      - visitor_vehicle

  census_counters_fr_engine:
    image: census_counters_fr_engine
    container_name: census_counters_fr_engine
    build:
      context: 'src/fr_engine/src/.'
      dockerfile: ./Dockerfile_trt
    restart: always
    stdin_open: true # -i
    tty: true #-t
    ports:
      - '18081:18080'
#    depends_on:
#      - census_counters_postgres_db
#      - census_counters_redis
    networks:
      - census_counters_network
    shm_size: 16gb
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ['0']
              capabilities: [gpu]
    volumes:
      - './src/fr_engine/models:/models'
      - './src/fr_engine/src:/app'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LOG_LEVEL: 'INFO'
      USE_NVJPEG: 'False'
      PYTHONUNBUFFERED: '0'
      PORT: '18080'
      NUM_WORKERS: '1'
      INFERENCE_BACKEND: 'trt'
      FORCE_FP16: 'False'
      DET_NAME: 'scrfd_10g_gnkps'
      DET_THRESH: '0.6'
      REC_NAME: 'adaface_ir101_webface12m'
      MASK_DETECTOR: 'mask_detector'
      REC_BATCH_SIZE: '1'
      DET_BATCH_SIZE: '1'
      GA_NAME: 'None'
      TRITON_URI: 'localhost:8001'
      KEEP_ALL: 'True'
      MAX_SIZE: '640,640'
      DEF_RETURN_FACE_DATA: 'False'
      DEF_EXTRACT_EMBEDDING: 'True'
      DEF_EXTRACT_GA: 'False'
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:18080/info || exit 1"]
      interval: 1m
      timeout: 10s
      retries: 3
    profiles:
      - visitor_vehicle

  census_counters_webservice_fr:
    image: census_counters_webservice_fr
    container_name: census_counters_webservice_fr
    build:
      context: .
      dockerfile: ./Dockerfile_webservice
    restart: always
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './src/frontend:/project'
      - './src/ANPR/anpr_webhook/images:/project/finalfrsproject/static/anpr_vehicles/'
    environment:
      SITE_PROFILE: ${SITE_PROFILE:-kupwara}
      ASSET_URL_VERSION: ${ASSET_URL_VERSION:-combined-2}
      FACE_RECOGNITION_SERVICE: ${FACE_RECOGNITION_SERVICE:-http://172.17.0.1:18081/}
      FACE_MATCH_CONFIDENCE: ${FACE_MATCH_CONFIDENCE:-0.70}
      POSTGRESQL_URL: ${POSTGRESQL_URL:-census_counters_postgres_db}
      REDIS_URL: ${REDIS_URL:-redis://census_counters_redis:6379/0}
      SECRET_KEY: ${SECRET_KEY:-development-only-change-this-secret}
    ports:
      - ${WEBSERVICE_HOST_PORT:-4001}:4001
    depends_on:
      - census_counters_fr_engine
    networks:
      - census_counters_network
    command: "/bin/bash ./run_webservice.sh"
    profiles:
      - visitor_vehicle

  census_counters_anpr_engine1:
    image: platerecognizer/alpr-stream
    container_name: census_counters_anpr_engine1
    stdin_open: true # -i
    tty: true #-t
    restart: always
    networks:
      - census_counters_network
    #    network_mode: host
    volumes:
      - './src/ANPR/anpr_data1:/user-data'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LICENSE_KEY: ${ANPR_LICENSE_KEY_1:-ABOVE_KEY_FOR_CAMERA_1}
      TOKEN: ${ANPR_TOKEN:-}

  census_counters_anpr_engine2:
    image: platerecognizer/alpr-stream
    container_name: census_counters_anpr_engine2
    stdin_open: true # -i
    tty: true #-t
    restart: always
    networks:
      - census_counters_network
    #    network_mode: host
    volumes:
      - './src/ANPR/anpr_data2:/user-data'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LICENSE_KEY: ${ANPR_LICENSE_KEY_2:-ABOVE_KEY_FOR_CAMERA_2}
      TOKEN: ${ANPR_TOKEN:-}
    profiles:
      - cameras_2_or_more

  census_counters_anpr_engine3:
    image: platerecognizer/alpr-stream
    container_name: census_counters_anpr_engine3
    stdin_open: true
    tty: true
    restart: always
    networks:
      - census_counters_network
    volumes:
      - './src/ANPR/anpr_data3:/user-data'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LICENSE_KEY: ${ANPR_LICENSE_KEY_3:-ABOVE_KEY_FOR_CAMERA_3}
      TOKEN: ${ANPR_TOKEN:-}
    profiles:
      - cameras_3_or_6

  census_counters_anpr_engine4:
    image: platerecognizer/alpr-stream
    container_name: census_counters_anpr_engine4
    stdin_open: true
    tty: true
    restart: always
    networks:
      - census_counters_network
    volumes:
      - './src/ANPR/anpr_data4:/user-data'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LICENSE_KEY: ${ANPR_LICENSE_KEY_4:-ABOVE_KEY_FOR_CAMERA_4}
      TOKEN: ${ANPR_TOKEN:-}
    profiles:
      - cameras_6

  census_counters_anpr_engine5:
    image: platerecognizer/alpr-stream
    container_name: census_counters_anpr_engine5
    stdin_open: true
    tty: true
    restart: always
    networks:
      - census_counters_network
    volumes:
      - './src/ANPR/anpr_data5:/user-data'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LICENSE_KEY: ${ANPR_LICENSE_KEY_5:-ABOVE_KEY_FOR_CAMERA_5}
      TOKEN: ${ANPR_TOKEN:-}
    profiles:
      - cameras_6

  census_counters_anpr_engine6:
    image: platerecognizer/alpr-stream
    container_name: census_counters_anpr_engine6
    stdin_open: true
    tty: true
    restart: always
    networks:
      - census_counters_network
    volumes:
      - './src/ANPR/anpr_data6:/user-data'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LICENSE_KEY: ${ANPR_LICENSE_KEY_6:-ABOVE_KEY_FOR_CAMERA_6}
      TOKEN: ${ANPR_TOKEN:-}
    profiles:
      - cameras_6

  census_counters_anpr_webhook:
    image: census_counters_anpr_webhook
    container_name: census_counters_anpr_webhook
    build:
      context: .
      dockerfile: ./Dockerfile_anpr_webhook
    stdin_open: true # -i
    tty: true #-t
    restart: always
    shm_size: 8gb
    volumes:
      - './src/ANPR/anpr_webhook:/project'
      - './src/ANPR/anpr_data:/project/uploads'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
#      - /tmp/.X11-unix:/tmp/.X11-unix
#      - /dev/shm:/dev/shm
#    network_mode: host
    ports:
      - 6068:6068
    networks:
      - census_counters_network
    environment:
      DISPLAY: $DISPLAY
    entrypoint:
      - /bin/bash
      - -c
      - |
          echo 'Giving Kafka container a bit of time to start up…'
          sleep 5
          ./run_anpr_webhook.sh
    profiles:
      - visitor_vehicle

  census_counters_cleanup_fr:
    image: census_counters_cleanup_fr
    container_name: census_counters_cleanup_fr
    build:
      context: .
      dockerfile: ./Dockerfile_cleanup
    restart: always
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './src:/project'
      - './src/ANPR/anpr_webhook/images:/anpr_images'
      - './src/ANPR:/anpr'
      - './src/frontend/finalfrsproject/static/images/uploads:/uploads'
    networks:
      - census_counters_network
    environment:
      CLEANUP_POLL_SECONDS: ${CLEANUP_POLL_SECONDS:-600}
      ANPR_RETENTION_SECONDS: ${ANPR_RETENTION_SECONDS:-1296000}
      UPLOAD_RETENTION_SECONDS: ${UPLOAD_RETENTION_SECONDS:-86400}
    entrypoint:
      - /bin/bash
      - -c
      - |
       echo 'Starting clean up service…'
        sleep 10
       ../run_cleanup.sh

  # Ganganagar-only optional worker. Start with:
  # docker compose --profile auto_close up -d census_counters_auto_close
  census_counters_auto_close:
    image: census_counters_auto_close
    container_name: census_counters_auto_close
    build:
      context: .
      dockerfile: ./Dockerfile_webservice
    restart: always
    working_dir: /project/auto_close
    volumes:
      - './src/auto_close:/project/auto_close:ro'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      SITE_PROFILE: ganganagar
      TRIP_CLOSURE_MODE: manual_and_anpr
      POSTGRESQL_URL: ${POSTGRESQL_URL:-census_counters_postgres_db}
      DB_PORT: ${DB_PORT:-5432}
      DB_NAME: ${DB_NAME:-postgres_visitor_vehicle}
      DB_USER_NAME: ${DB_USER_NAME:-postgres}
      DB_PASSWORD: ${DB_PASSWORD:-postgres}
      AUTO_CLOSE_POLL_SECONDS: ${AUTO_CLOSE_POLL_SECONDS:-600}
      AUTO_CLOSE_READING_WINDOW_SECONDS: ${AUTO_CLOSE_READING_WINDOW_SECONDS:-60}
    networks:
      - census_counters_network
    command: ["python3", "auto_close.py"]
    profiles:
      - auto_close

  # NCPass-only monitoring stack. External alert/image-sharing endpoints and
  # credentials are intentionally supplied through environment variables.
  census_counters_zookeeper:
    image: confluentinc/cp-zookeeper:7.3.0
    container_name: census_counters_zookeeper
    restart: always
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
    networks:
      - census_counters_network
    profiles:
      - top_report

  census_counters_broker:
    image: confluentinc/cp-kafka:7.3.0
    container_name: census_counters_broker
    restart: always
    depends_on:
      - census_counters_zookeeper
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: census_counters_zookeeper:2181
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://census_counters_broker:9092
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
    networks:
      - census_counters_network
    profiles:
      - top_report

  census_counters_top_report:
    image: census_counters_top_report
    container_name: census_counters_top_report
    build:
      context: .
      dockerfile: ./Dockerfile_topreport
    restart: always
    depends_on:
      - census_counters_broker
    environment:
      CPU_USAGE_THRESHOLD: ${CPU_USAGE_THRESHOLD:-75}
      CPU_MEMORY_USAGE_THRESHOLD: ${CPU_MEMORY_USAGE_THRESHOLD:-75}
      CPU_TEMPERATURE_USAGE_THRESHOLD: ${CPU_TEMPERATURE_USAGE_THRESHOLD:-90}
      STORAGE_LABEL: ${STORAGE_LABEL:-/dev/root}
      STORAGE_USE_THRESHOLD: ${STORAGE_USE_THRESHOLD:-85}
      SHM_USE_THRESHOLD: ${SHM_USE_THRESHOLD:-85}
      GPU_USAGE_THRESHOLD: ${GPU_USAGE_THRESHOLD:-85}
      GPU_MEMORY_USAGE_THRESHOLD: ${GPU_MEMORY_USAGE_THRESHOLD:-85}
      SLEEP_TIME: ${TOP_REPORT_SLEEP_SECONDS:-300}
      REST_API_END_POINT: ${REST_API_END_POINT:-}
      EMAIL_ADDRESSES: ${EMAIL_ADDRESSES:-}
      LOGS_FOLDER: /project/logs/
      ENGINE_REGISTRY_URL: ${ENGINE_REGISTRY_URL:-http://census_counters_webservice_fr:8087/register-engines}
      POSTGRESQL_URL: ${POSTGRESQL_URL:-census_counters_postgres_db}
      DB_PORT: ${DB_PORT:-5432}
      DB_NAME: ${DB_NAME:-postgres_visitor_vehicle}
      DB_USER_NAME: ${DB_USER_NAME:-postgres}
      DB_PASSWORD: ${DB_PASSWORD:-postgres}
      IMAGE_SHARE_API_URL: ${IMAGE_SHARE_API_URL:-}
      IMAGE_SHARE_API_KEY: ${IMAGE_SHARE_API_KEY:-}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - './src/logs:/project/logs'
      - './src/frontend/finalfrsproject/static/known_persons:/known_persons:ro'
    networks:
      - census_counters_network
    profiles:
      - top_report

  # Optional TLS/static-asset reverse proxy for NCPass and Ganganagar. Supply
  # nginx.crt/nginx.key through NGINX_SSL_DIR; no certificates live in git.
  census_counters_nginx:
    image: nginx:alpine
    container_name: census_counters_nginx
    restart: always
    ports:
      - "${PUBLIC_HTTPS_PORT:-4443}:4001"
    volumes:
      - './nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro'
      - '${NGINX_SSL_DIR:-./nginx/ssl}:/etc/nginx/ssl:ro'
      - './src/frontend/finalfrsproject/static:/var/www/static:ro'
      - './src/ANPR/anpr_webhook/images:/var/www/static/anpr_vehicles:ro'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - census_counters_network
    depends_on:
      - census_counters_webservice_fr
    profiles:
      - reverse_proxy
