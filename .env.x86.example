# x86 host with a discrete NVIDIA GPU (driver 595+) overrides for docker compose.
# Usage: cp .env.x86.example .env
# These values match the compose defaults, so a missing .env behaves the same.

# /dev/shm size limit for the face recognition engine container
FR_SHM_SIZE=1gb

# Gunicorn workers for the web service (each worker is a separate process)
GUNICORN_WORKERS=3

# Milvus face index: FLAT (exact), IVF_FLAT or HNSW
FACE_INDEX_TYPE=FLAT

# Container memory limits (host RAM, not GPU VRAM); a container hitting its limit is
# OOM-killed and restarted. Tune after checking real usage with `docker stats`.
MEM_LIMIT_MILVUS=2g
MEM_LIMIT_FR_ENGINE=4g
MEM_LIMIT_WEBSERVICE=1536m
