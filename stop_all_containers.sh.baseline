#!/usr/bin/env bash
set -euo pipefail

COMPOSE_FILE="docker-compose-census-counters-visitor-vehicle.yml"

# Include every compose profile so postgres/redis and optional services are stopped too.
docker compose -f "$COMPOSE_FILE" \
  --profile bundled_infra \
  --profile visitor_vehicle \
  --profile cameras_2_or_more \
  --profile cameras_3_or_6 \
  --profile cameras_6 \
  --profile auto_close \
  --profile top_report \
  --profile reverse_proxy \
  down

# Stop any leftover census_counters* containers started outside this compose run.
mapfile -t leftover_ids < <(docker ps -aq --filter "name=census_counters")
if ((${#leftover_ids[@]})); then
  docker stop "${leftover_ids[@]}" >/dev/null 2>&1 || true
  docker rm "${leftover_ids[@]}" >/dev/null 2>&1 || true
fi
