networks:
  census_counters_network:
    external: true

volumes:
  # Single-container Milvus data (embedded etcd + local storage). The legacy
  # census_counters_facedb/etcd/minio volumes are no longer used; see README.
  census_counters_milvus:
    driver: local

services:
  census_counters_facedb:
    container_name: census_counters_facedb
    image: milvusdb/milvus:v2.6.25
    command: ["milvus", "run", "standalone"]
    restart: always
    security_opt:
      - seccomp:unconfined
    environment:
      ETCD_USE_EMBED: 'true'
      ETCD_DATA_DIR: /var/lib/milvus/etcd
      ETCD_CONFIG_PATH: /milvus/configs/embedEtcd.yaml
      COMMON_STORAGETYPE: local
      DEPLOY_MODE: STANDALONE
    mem_limit: ${MEM_LIMIT_MILVUS:-2g}
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './conf/milvus/embedEtcd.yaml:/milvus/configs/embedEtcd.yaml:ro'
      - './conf/milvus/user.yaml:/milvus/configs/user.yaml:ro'
      - census_counters_milvus:/var/lib/milvus
    networks:
      - census_counters_network
    ports:
      - "19530:19530"
      - "9091:9091"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9091/healthz"]
      interval: 30s
      start_period: 90s
      timeout: 20s
      retries: 3

  census_counters_fr_engine:
    image: census_counters_fr_engine
    container_name: census_counters_fr_engine
    build:
      context: 'src/fr_engine/src/.'
      dockerfile: ./Dockerfile_trt
    restart: always
    stdin_open: true # -i
    tty: true #-t
    ports:
      - '18081:18080'
    depends_on:
      census_counters_facedb:
        condition: service_healthy
    networks:
      - census_counters_network
    runtime: nvidia
    shm_size: ${FR_SHM_SIZE:-1gb}
    # Caps host RAM only; on x86 GPU memory (VRAM) is not counted.
    mem_limit: ${MEM_LIMIT_FR_ENGINE:-4g}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    volumes:
      - './src/fr_engine/models:/models'
      - './src/fr_engine/src:/app'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LOG_LEVEL: 'INFO'
      USE_NVJPEG: 'False'
      PYTHONUNBUFFERED: '0'
      PORT: '18080'
      NUM_WORKERS: '1'
      INFERENCE_BACKEND: 'trt'
      FORCE_FP16: 'False'
      DET_NAME: 'auraface_scrfd_10g_bnkps'
      DEF_DET_THRESH: '0.6'
      DET_RETRY_SCALE: '0.5'
      REC_NAME: 'auraface_glintr100'
      MASK_DETECTOR: 'None'
      REC_BATCH_SIZE: '1'
      DET_BATCH_SIZE: '1'
      GA_NAME: 'None'
      TRITON_URI: 'localhost:8001'
      KEEP_ALL: 'True'
      MAX_SIZE: '640,640'
      DEF_RETURN_FACE_DATA: 'False'
      DEF_EXTRACT_EMBEDDING: 'True'
      DEF_EXTRACT_GA: 'False'
      FACE_INDEX_TYPE: ${FACE_INDEX_TYPE:-FLAT}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:18080/info || exit 1"]
      interval: 1m
      timeout: 10s
      retries: 3

  census_counters_webservice_fr:
    image: census_counters_webservice_fr
    container_name: census_counters_webservice_fr
    build:
      context: .
      dockerfile: ./Dockerfile_webservice
    restart: always
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './src/frontend:/project'
      - './src/ANPR/anpr_webhook/images:/project/finalfrsproject/static/anpr_vehicles/'
    environment:
      SITE_PROFILE: kupwara
      SECRET_KEY: development-only-change-this-secret
      GUNICORN_WORKERS: ${GUNICORN_WORKERS:-3}
    mem_limit: ${MEM_LIMIT_WEBSERVICE:-2000m}
    depends_on:
      - census_counters_fr_engine
    networks:
      - census_counters_network
    command: "/bin/bash ./run_webservice.sh"

  census_counters_cleanup_fr:
    image: census_counters_cleanup_fr
    container_name: census_counters_cleanup_fr
    build:
      context: .
      dockerfile: ./Dockerfile_cleanup
    restart: always
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './src:/project'
      - './src/ANPR/anpr_webhook/images:/anpr_images'
      - './src/ANPR:/anpr'
      - './src/frontend/finalfrsproject/static/images/uploads:/uploads'
    networks:
      - census_counters_network
    environment:
      CLEANUP_POLL_SECONDS: 600
      ANPR_RETENTION_SECONDS: 1296000
      UPLOAD_RETENTION_SECONDS: 86400
    mem_limit: 256m
    entrypoint:
      - /bin/bash
      - -c
      - |
       echo 'Starting clean up service…'
        sleep 10
       ../run_cleanup.sh

  # Ganganagar-only optional worker.
  census_counters_auto_close:
    image: census_counters_auto_close
    container_name: census_counters_auto_close
    build:
      context: .
      dockerfile: ./Dockerfile_webservice
    restart: always
    working_dir: /project/auto_close
    volumes:
      - './src/auto_close:/project/auto_close:ro'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      SITE_PROFILE: ganganagar
      TRIP_CLOSURE_MODE: manual_and_anpr
      AUTO_CLOSE_POLL_SECONDS: 600
      AUTO_CLOSE_READING_WINDOW_SECONDS: 60
    mem_limit: 256m
    networks:
      - census_counters_network
    command: ["python3", "auto_close.py"]

  census_counters_nginx:
    image: nginx:alpine
    container_name: census_counters_nginx
    restart: always
    mem_limit: 128m
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - './nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro'
      - './nginx/ssl:/etc/nginx/ssl:ro'
      - './src/frontend/finalfrsproject/static:/var/www/static:ro'
      - './src/ANPR/anpr_webhook/images:/var/www/static/anpr_vehicles:ro'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - census_counters_network
    depends_on:
      - census_counters_webservice_fr