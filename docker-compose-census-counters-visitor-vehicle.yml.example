networks:
  enrollment_maintenance:
    internal: true
  census_counters_network:
    external: true

volumes:
  # Shared Milvus data (separate etcd + local storage). The legacy
  # census_counters_facedb/etcd/minio volumes are no longer used; see README.
  census_counters_milvus:
    driver: local
  census_counters_enrollment_queue:
    driver: local

services:
  census_counters_fr_etcd:
    image: quay.io/coreos/etcd:v3.5.25
    restart: always
    environment:
      ETCD_AUTO_COMPACTION_MODE: revision
      ETCD_AUTO_COMPACTION_RETENTION: '1000'
      ETCD_QUOTA_BACKEND_BYTES: '4294967296'
    command:
      - etcd
      - --name=default
      - --data-dir=/var/lib/milvus/etcd
      - --listen-client-urls=http://0.0.0.0:2379
      - --advertise-client-urls=http://0.0.0.0:2379
    volumes:
      - census_counters_milvus:/var/lib/milvus
    networks:
      - census_counters_network
    healthcheck:
      test: ["CMD", "etcdctl", "endpoint", "health"]
      interval: 5s
      timeout: 5s
      retries: 30

  census_counters_facedb:
    container_name: census_counters_facedb
    image: milvusdb/milvus:v2.6.25
    command: ["milvus", "run", "standalone"]
    restart: always
    security_opt:
      - seccomp:unconfined
    environment:
      ETCD_USE_EMBED: 'false'
      ETCD_ENDPOINTS: census_counters_fr_etcd:2379
      COMMON_STORAGETYPE: local
      DEPLOY_MODE: STANDALONE
    depends_on:
      census_counters_fr_etcd:
        condition: service_healthy
    mem_limit: ${MEM_LIMIT_MILVUS:-2g}
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './conf/milvus/embedEtcd.yaml:/milvus/configs/embedEtcd.yaml:ro'
      - './conf/milvus/user.yaml:/milvus/configs/user.yaml:ro'
      - census_counters_milvus:/var/lib/milvus
    networks:
      - census_counters_network
    ports:
      - "19530:19530"
      - "9091:9091"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9091/healthz"]
      interval: 30s
      start_period: 90s
      timeout: 20s
      retries: 3

  census_counters_fr_engine:
    image: census_counters_fr_engine
    container_name: census_counters_fr_engine
    build:
      context: 'src/fr_engine/src/.'
      dockerfile: ./Dockerfile_trt
    restart: always
    stdin_open: true # -i
    tty: true #-t
    ports:
      - '18081:18080'
    depends_on:
      census_counters_facedb:
        condition: service_healthy
    networks:
      - census_counters_network
    runtime: nvidia
    shm_size: ${FR_SHM_SIZE:-1gb}
    # Caps host RAM only; on x86 GPU memory (VRAM) is not counted.
    mem_limit: ${MEM_LIMIT_FR_ENGINE:-4g}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    volumes:
      - './enrollment-data:/maintenance'
      - './src/frontend/enrollment_data/guard.py:/app/maintenance_guard.py:ro'
      - './src/fr_engine/models:/models'
      - './src/fr_engine/src:/app'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      LOG_LEVEL: 'INFO'
      USE_NVJPEG: 'False'
      PYTHONUNBUFFERED: '0'
      PORT: '18080'
      NUM_WORKERS: '1'
      INFERENCE_BACKEND: 'trt'
      FORCE_FP16: 'False'
      DET_NAME: 'auraface_scrfd_10g_bnkps'
      DEF_DET_THRESH: '0.6'
      DET_RETRY_SCALE: '0.5'
      REC_NAME: 'auraface_glintr100'
      MASK_DETECTOR: 'None'
      REC_BATCH_SIZE: '1'
      DET_BATCH_SIZE: '1'
      GA_NAME: 'None'
      TRITON_URI: 'localhost:8001'
      KEEP_ALL: 'True'
      MAX_SIZE: '640,640'
      DEF_RETURN_FACE_DATA: 'False'
      DEF_EXTRACT_EMBEDDING: 'True'
      DEF_EXTRACT_GA: 'False'
      FACE_INDEX_TYPE: ${FACE_INDEX_TYPE:-FLAT}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:18080/info || exit 1"]
      interval: 1m
      timeout: 10s
      retries: 3

  census_counters_webservice_fr:
    image: census_counters_webservice_fr
    container_name: census_counters_webservice_fr
    build:
      context: .
      dockerfile: ./Dockerfile_webservice
    restart: always
    volumes:
      - './enrollment-data:/maintenance'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './src/frontend:/project'
      - './src/ANPR/anpr_webhook/images:/project/finalfrsproject/static/anpr_vehicles/'
      - '/var/opt/censuscounters/src/frontend/finalfrsproject/static/images/snapshots:/project/finalfrsproject/static/images/snapshots:ro'
    environment:
      POSTGRESQL_URL: ${POSTGRESQL_URL:-census_counters_postgres_db}
      DB_NAME: ${DB_NAME:-postgres_visitor_vehicle}
      DB_USER_NAME: ${DB_USER_NAME:-postgres}
      DB_PASSWORD: ${DB_PASSWORD:-postgres}
      DB_PORT: ${DB_PORT:-5432}
      REDIS_URL: ${REDIS_URL:-redis://census_counters_redis:6379/0}
      ENROLLMENT_MAX_BYTES: ${ENROLLMENT_MAX_BYTES:-536870912}
      ENROLLMENT_EMBEDDING_MODEL: ${ENROLLMENT_EMBEDDING_MODEL:-auraface_glintr100}
      SITE_PROFILE: kupwara
      SECRET_KEY: development-only-change-this-secret
      GUNICORN_WORKERS: ${GUNICORN_WORKERS:-3}
    mem_limit: ${MEM_LIMIT_WEBSERVICE:-2000m}
    depends_on:
      - census_counters_fr_engine
    networks:
      - census_counters_network
    command: "/bin/bash ./run_webservice.sh"

  census_counters_cleanup_fr:
    image: census_counters_cleanup_fr
    container_name: census_counters_cleanup_fr
    build:
      context: .
      dockerfile: ./Dockerfile_cleanup
    restart: always
    volumes:
      - './enrollment-data:/maintenance'
      - './src/frontend/enrollment_data/guard.py:/project/cleanup/maintenance_guard.py:ro'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - './src:/project'
      - './src/ANPR/anpr_webhook/images:/anpr_images'
      - './src/ANPR:/anpr'
      - './src/frontend/finalfrsproject/static/images/uploads:/uploads'
    networks:
      - census_counters_network
    environment:
      CLEANUP_POLL_SECONDS: 600
      ANPR_RETENTION_SECONDS: 1296000
      UPLOAD_RETENTION_SECONDS: 86400
    mem_limit: 256m
    entrypoint:
      - /bin/bash
      - -c
      - |
       echo 'Starting clean up service…'
        sleep 10
       ../run_cleanup.sh

  # Ganganagar-only optional worker.
  census_counters_auto_close:
    image: census_counters_auto_close
    container_name: census_counters_auto_close
    build:
      context: .
      dockerfile: ./Dockerfile_webservice
    restart: always
    working_dir: /project/auto_close
    volumes:
      - './src/auto_close:/project/auto_close:ro'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      SITE_PROFILE: ganganagar
      TRIP_CLOSURE_MODE: manual_and_anpr
      AUTO_CLOSE_POLL_SECONDS: 600
      AUTO_CLOSE_READING_WINDOW_SECONDS: 60
    mem_limit: 256m
    networks:
      - census_counters_network
    command: ["python3", "auto_close.py"]

  census_counters_nginx:
    image: nginx:alpine
    container_name: census_counters_nginx
    restart: always
    mem_limit: 128m
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - './nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro'
      - './nginx/ssl:/etc/nginx/ssl:ro'
      - './src/frontend/finalfrsproject/static:/var/www/static:ro'
      - './src/ANPR/anpr_webhook/images:/var/www/static/anpr_vehicles:ro'
      - '/var/opt/censuscounters/src/frontend/finalfrsproject/static/images/snapshots:/var/www/static/images/snapshots:ro'
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - census_counters_network
    depends_on:
      - census_counters_webservice_fr

  census_counters_enrollment_redis:
    image: redis:7.4-alpine
    restart: always
    command: ["redis-server", "--appendonly", "yes", "--appendfsync", "everysec", "--maxmemory", "128mb", "--maxmemory-policy", "noeviction"]
    volumes:
      - census_counters_enrollment_queue:/data
    networks:
      - enrollment_maintenance
    mem_limit: 256m
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  census_counters_enrollment_worker: &enrollment-worker
    image: census_counters_webservice_fr
    build:
      context: .
      dockerfile: ./Dockerfile_webservice
    restart: always
    working_dir: /project
    command: ["python3", "-m", "enrollment_data.worker"]
    stop_grace_period: 90s
    healthcheck:
      test: ["CMD", "python3", "-m", "enrollment_data.health", "worker"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    environment:
      POSTGRESQL_URL: ${POSTGRESQL_URL:-census_counters_postgres_db}
      DB_NAME: ${DB_NAME:-postgres_visitor_vehicle}
      DB_USER_NAME: ${DB_USER_NAME:-postgres}
      DB_PASSWORD: ${DB_PASSWORD:-postgres}
      DB_PORT: ${DB_PORT:-5432}
      REDIS_URL: ${REDIS_URL:-redis://census_counters_redis:6379/0}
      ENROLLMENT_MAX_BYTES: ${ENROLLMENT_MAX_BYTES:-536870912}
      ENROLLMENT_EMBEDDING_MODEL: ${ENROLLMENT_EMBEDDING_MODEL:-auraface_glintr100}
      ENROLLMENT_REDIS_URL: redis://census_counters_enrollment_redis:6379/0
      ENROLLMENT_JOB_TIMEOUT: ${ENROLLMENT_JOB_TIMEOUT:-7200}
    volumes:
      - './enrollment-data:/maintenance'
      - '/etc/timezone:/etc/timezone:ro'
      - '/etc/localtime:/etc/localtime:ro'
      - './src/frontend:/project'
      - './src/ANPR/anpr_webhook/images:/project/finalfrsproject/static/anpr_vehicles/'
      - '/var/opt/censuscounters/src/frontend/finalfrsproject/static/images/snapshots:/project/finalfrsproject/static/images/snapshots:ro'
    networks:
      - census_counters_network
      - enrollment_maintenance
    mem_limit: 1g
    depends_on:
      census_counters_enrollment_redis:
        condition: service_healthy
      census_counters_facedb:
        condition: service_healthy

  census_counters_enrollment_dispatcher:
    <<: *enrollment-worker
    command: ["python3", "-m", "enrollment_data.dispatcher"]
    healthcheck:
      test: ["CMD", "python3", "-m", "enrollment_data.health", "dispatcher"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    mem_limit: 256m
