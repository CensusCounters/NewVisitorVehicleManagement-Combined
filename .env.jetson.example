# Jetson Orin Nano (8 GB shared CPU/GPU memory) overrides for docker compose.
# Usage: cp .env.jetson.example .env
# For x86 hosts use .env.x86.example instead.

# /dev/shm size limit for the face recognition engine container
FR_SHM_SIZE=1gb

# Gunicorn workers for the web service (each worker is a separate process).
# Two workers on an 8 GB Orin; the GPU and Milvus share this RAM.
GUNICORN_WORKERS=2

# Milvus face index: FLAT (exact), IVF_FLAT or HNSW
FACE_INDEX_TYPE=FLAT

# Container memory limits. On Jetson these include GPU allocations, because
# the GPU uses system RAM. A container hitting its limit is OOM-killed and restarted.
# The face engine needs several GB while it compiles TensorRT engines the first
# time. After the .plan files exist, runtime use is lower.
# Tune after checking real usage with `docker stats` / `tegrastats`.
MEM_LIMIT_MILVUS=1536m
MEM_LIMIT_FR_ENGINE=5g
MEM_LIMIT_WEBSERVICE=800m
